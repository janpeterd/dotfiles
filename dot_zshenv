# Environment for every zsh: interactive shells, scripts, and agent commands.
# Keep this fast and limited to what child processes need. Interactive setup
# belongs in ~/.config/zsh/.zshrc; session-wide values for GUI apps belong in
# ~/.config/environment.d/.

# --- XDG base directories ---------------------------------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_PICTURES_DIR="$HOME/Pictures"
export XDG_SCREENSHOTS_DIR="$HOME/Pictures/Screenshots"
export XDG_DOCUMENTS_DIR="$HOME/Documents"
export XDG_VIDEOS_DIR="$HOME/Videos"
export XDG_MUSIC_DIR="$HOME/Music"
export XDG_DOWNLOAD_DIR="$HOME/Downloads"

# zsh keeps its interactive files in the XDG config dir. ~/.config/zsh/.zshenv
# is a symlink to this file, so zsh finds it whether or not ZDOTDIR is already
# exported in the environment.
ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# --- Editors and terminal tools ---------------------------------------------
export EDITOR=nvim
export VISUAL=nvim
export BROWSER=helium-browser
export TERMINAL=kitty
export LESSHISTFILE=-
export GRIM_DEFAULT_DIR="$XDG_SCREENSHOTS_DIR"

# --- Toolchain roots --------------------------------------------------------
export PNPM_HOME="$XDG_DATA_HOME/pnpm"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export GOPATH="$XDG_DATA_HOME/go"
# Prefer sdkman's current Java/Maven so agents and interactive shells agree.
if [[ -x "$HOME/.sdkman/candidates/java/current/bin/java" ]]; then
  export JAVA_HOME="$HOME/.sdkman/candidates/java/current"
  _java_bins=("$JAVA_HOME/bin" "$HOME/.sdkman/candidates/maven/current/bin")
else
  export JAVA_HOME=/usr/lib/jvm/default
  _java_bins=("$JAVA_HOME/bin")
fi
export _JAVA_AWT_WM_NONREPARENTING=1
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export ANDROID_SDK_HOME="$XDG_CONFIG_HOME/android"

# --- Application config locations that are not XDG-aware --------------------
export XINITRC="$XDG_CONFIG_HOME/x11/xinitrc"
export NOTMUCH_CONFIG="$XDG_CONFIG_HOME/notmuch-config"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc-2.0"
export INPUTRC="$XDG_CONFIG_HOME/shell/inputrc"
export WGETRC="$XDG_CONFIG_HOME/wget/wgetrc"
export ANSIBLE_CONFIG="$XDG_CONFIG_HOME/ansible/ansible.cfg"
export WINEPREFIX="$XDG_DATA_HOME/wineprefixes/default"
export KODI_DATA="$XDG_DATA_HOME/kodi"
export PASSWORD_STORE_DIR="$XDG_DATA_HOME/password-store"
export UNISON="$XDG_DATA_HOME/unison"
export MBSYNCRC="$XDG_CONFIG_HOME/mbsync/config"
export TMUX_TMPDIR="${XDG_RUNTIME_DIR:-/run/user/$UID}"
export MOZ_ENABLE_WAYLAND=1

# --- Local development conventions ------------------------------------------
export JP_PROJECTS_ROOT="$HOME/Projects/src"
export JP_STATE_ROOT="$HOME/Projects/state"
export JP_ENV_ROOT="$XDG_CONFIG_HOME/jpserv/env"
export VAULT_ADDR=https://vault.int.vito.be

# --- PATH -------------------------------------------------------------------
# Deduplicate and only add directories that non-interactive processes
# (scripts, agents, GUI apps) need. Interactive toolchains such as sdkman are
# loaded lazily from .zshrc.
typeset -U path
path=(
  "$HOME/.local/bin"
  "$HOME/.bun/bin"
  "$HOME/.nub/bin"
  "$HOME/.npm-global/bin"
  "$GOPATH/bin"
  "$HOME/.opencode/bin"
  "$HOME/.local/share/JetBrains/Toolbox/scripts"
  "$PNPM_HOME/bin"
  "${_java_bins[@]}"
  $path
)
unset _java_bins

# Optional tool directories, added only if they exist on this machine.
for _dir in \
  "$HOME/Code/scripts/bin" \
  "$HOME/.config/emacs/bin" \
  "$HOME/.yarn/bin" \
  "$HOME/Code/Projects/Android_bookmarks/flutter/bin"; do
  [[ -d "$_dir" ]] && path+=("$_dir")
done
unset _dir

# Machine-local tokens and overrides (see .chezmoiignore).
[[ -r "$HOME/.zshenv.local" ]] && source "$HOME/.zshenv.local"

# vim:ft=zsh
