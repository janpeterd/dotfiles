#!/usr/bin/env bash
set -euo pipefail

forbidden="$(printf '\u2014')"
status=0

while IFS= read -r -d '' path; do
  if [[ "$path" == *"$forbidden"* ]]; then
    printf 'forbidden em dash in path: %s\n' "$path"
    status=1
  fi
done < <(find . -path './.git' -prune -o -print0)

if rg -n --hidden --glob '!.git/**' "$forbidden" .; then
  status=1
fi

if (( status != 0 )); then
  printf 'check failed: replace every em dash\n' >&2
  exit 1
fi

python3 scripts/check_repo.py
printf 'checks passed\n'
