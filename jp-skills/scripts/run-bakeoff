#!/usr/bin/env bash
set -euo pipefail

if (( $# != 3 )); then
  printf 'usage: %s CASE_DIR PROPOSED_SKILL PRIOR_SKILL_OR_DASH\n' "$0" >&2
  exit 2
fi

case_dir=$(realpath "$1")
proposed=$(realpath "$2")
prior=$3
if [[ "$prior" != - ]]; then
  prior=$(realpath "$prior")
fi

models=${BAKEOFF_MODELS:-openai-codex/gpt-5.6-sol,openai-codex/gpt-6-astra}
mode=${CASE_MODE:-execution}
trials=${BAKEOFF_TRIALS:-2}
concurrency=${BAKEOFF_CONCURRENCY:-4}
if [[ "$mode" != execution && "$mode" != discovery ]]; then
  printf 'CASE_MODE must be execution or discovery\n' >&2
  exit 2
fi
if [[ ! "$trials" =~ ^[1-9][0-9]*$ || ! "$concurrency" =~ ^[1-9][0-9]*$ ]]; then
  printf 'trials and concurrency must be positive integers\n' >&2
  exit 2
fi
IFS=, read -r -a model_entries <<<"$models"

providers=()
for entry in "${model_entries[@]}"; do
  if [[ "$entry" != */* ]]; then
    printf 'model must include provider: %s\n' "$entry" >&2
    exit 2
  fi
  provider=${entry%%/*}
  if [[ "${entry,,}" == *anthropic* || "${entry,,}" == *claude* ]]; then
    printf 'Anthropic and Claude are forbidden, including proxy aliases\n' >&2
    exit 2
  fi
  if [[ "$provider" != openai && "$provider" != openai-codex ]]; then
    printf 'Evaluation providers must be direct OpenAI: openai or openai-codex\n' >&2
    exit 2
  fi
  [[ " ${providers[*]} " == *" $provider "* ]] || providers+=("$provider")
done

if [[ ${BAKEOFF_DRY_RUN:-0} != 1 ]]; then
  for provider in "${providers[@]}"; do
    pi auth check --provider "$provider" --no-refresh >/dev/null
  done
fi

case_name=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["name"])' "$case_dir/case.json")
stamp=$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p "${RUN_ROOT:-runs}"
root=$(mktemp -d "${RUN_ROOT:-runs}/bakeoff-${stamp}-${case_name}.XXXXXX")
printf 'OpenAI-only comparison: multiple models, one model family.\n' >"$root/model-scope.txt"
printf 'arm\tprovider\tmodel\ttrial\tmode\tstatus\tresult\n' >"$root/index.tsv"

if [[ "$prior" == - ]]; then
  printf 'prior arm omitted: this run cannot promote a revision\n' >"$root/notice.txt"
fi

run_trial() {
  local arm=$1 skill=$2 provider=$3 model=$4 trial=$5 output status
  if [[ ${BAKEOFF_DRY_RUN:-0} == 1 ]]; then
    printf '%s\t%s\t%s\t%s\t%s\t0\tdry-run\n' "$arm" "$provider" "$model" "$trial" "$mode" >>"$root/index.tsv"
    return
  fi
  if [[ "$skill" == - ]]; then
    if output=$(CASE_MODE="$mode" CASE_ARM="$arm" CASE_TRIAL="$trial" CASE_PROVIDER="$provider" CASE_MODEL="$model" RUN_ROOT="$root" ./scripts/run-case "$case_dir"); then
      status=0
    else
      status=$?
    fi
  else
    if output=$(CASE_MODE="$mode" CASE_ARM="$arm" CASE_TRIAL="$trial" CASE_PROVIDER="$provider" CASE_MODEL="$model" RUN_ROOT="$root" ./scripts/run-case "$case_dir" "$skill"); then
      status=0
    else
      status=$?
    fi
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$arm" "$provider" "$model" "$trial" "$mode" "$status" "$output" >>"$root/index.tsv"
}

python3 - "$root" "$models" "$trials" "$proposed" "$prior" "${BAKEOFF_SEED:-1729}" "$mode" <<'SCHEDULE'
import json
from pathlib import Path
import random
import sys

root, models, trials, proposed, prior, seed, mode = sys.argv[1:]
arms = [('absent', '-'), ('proposed', proposed)]
if prior != '-':
    arms.append(('prior', prior))
schedule = [dict(arm=arm, skill=skill, provider=entry.split('/', 1)[0],
                 model=entry.split('/', 1)[1], trial=trial)
            for arm, skill in arms for entry in models.split(',')
            for trial in range(1, int(trials) + 1)]
random.Random(seed).shuffle(schedule)
Path(root, 'schedule.json').write_text(json.dumps(
    dict(seed=seed, mode=mode, model_families=['openai'], schedule=schedule), indent=2) + '\n')
Path(root, 'schedule.tsv').write_text(''.join(
    '\t'.join(str(cell[key]) for key in ('arm', 'skill', 'provider', 'model', 'trial')) + '\n'
    for cell in schedule))
SCHEDULE

while IFS=$'\t' read -r arm skill provider model trial; do
  run_trial "$arm" "$skill" "$provider" "$model" "$trial" </dev/null &
  while (( $(jobs -rp | wc -l) >= concurrency )); do
    wait -n || true
  done
done <"$root/schedule.tsv"
wait || true

printf '%s\n' "$root"
python3 - "$root" <<'STATUS'
import csv
import json
from pathlib import Path
import sys

root = Path(sys.argv[1])
with (root / 'index.tsv').open() as stream:
    cells = list(csv.DictReader(stream, delimiter='\t'))
expected = len(json.loads((root / 'schedule.json').read_text())['schedule'])
status = 2 if len(cells) != expected else max((int(cell['status']) for cell in cells), default=2)
(root / 'status').write_text(str(status) + '\n')
sys.exit(status)
STATUS
