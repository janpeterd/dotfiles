#!/usr/bin/env python3
"""Git credential helper using user-scoped systemd encrypted credentials."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

EXPECTED_HOST = "git.janpeterdhalle.com"


def credential_path() -> Path:
    configured = os.environ.get(
        "JP_FORGEJO_CREDENTIAL_FILE",
        "~/.local/share/git/credentials/forgejo.cred",
    )
    return Path(configured).expanduser().resolve()


def read_request() -> dict[str, str]:
    result: dict[str, str] = {}
    for raw_line in sys.stdin:
        line = raw_line.rstrip("\n")
        if not line:
            break
        if "=" in line:
            key, value = line.split("=", 1)
            result[key] = value
    return result


def applies(request: dict[str, str]) -> bool:
    return request.get("protocol", "https") == "https" and request.get("host", EXPECTED_HOST) == EXPECTED_HOST


def encrypt(payload: dict[str, str]) -> None:
    destination = credential_path()
    destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    destination.parent.chmod(0o700)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".forgejo.", dir=destination.parent)
    os.close(descriptor)
    temporary = Path(temporary_name)
    try:
        completed = subprocess.run(
            [
                "systemd-creds",
                "-q",
                "--user",
                "--name=forgejo-git",
                "encrypt",
                "-",
                str(temporary),
            ],
            input=(json.dumps(payload) + "\n").encode(),
            stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE,
        )
        if completed.returncode:
            raise RuntimeError(completed.stderr.decode(errors="replace").strip())
        temporary.chmod(0o600)
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def decrypt() -> dict[str, str] | None:
    source = credential_path()
    if not source.is_file():
        return None
    completed = subprocess.run(
        [
            "systemd-creds",
            "-q",
            "--user",
            "--name=forgejo-git",
            "decrypt",
            str(source),
            "-",
        ],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if completed.returncode:
        raise RuntimeError(completed.stderr.decode(errors="replace").strip())
    data = json.loads(completed.stdout)
    if not isinstance(data, dict):
        raise RuntimeError("decrypted credential is not an object")
    return {str(key): str(value) for key, value in data.items()}


def main() -> int:
    if len(sys.argv) != 2 or sys.argv[1] not in {"get", "store", "erase"}:
        print("usage: git-credential-forgejo-systemd <get|store|erase>", file=sys.stderr)
        return 2
    action = sys.argv[1]
    request = read_request()
    if not applies(request):
        return 0
    if action == "store":
        username = request.get("username")
        password = request.get("password")
        if not username or not password:
            return 0
        encrypt({"host": EXPECTED_HOST, "username": username, "password": password})
        return 0
    if action == "erase":
        credential_path().unlink(missing_ok=True)
        return 0
    stored = decrypt()
    if not stored or stored.get("host") != EXPECTED_HOST:
        return 0
    print(f"username={stored['username']}")
    print(f"password={stored['password']}")
    print()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, json.JSONDecodeError, KeyError) as error:
        print(f"git-credential-forgejo-systemd: {error}", file=sys.stderr)
        raise SystemExit(1)
